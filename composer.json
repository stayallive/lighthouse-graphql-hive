{
    "name": "stayallive/lighthouse-graphql-hive",
    "type": "library",
    "description": "Performance monitoring Lighthouse with GraphQL Hive.",
    "keywords": [
        "laravel",
        "lighthouse",
        "graphql",
        "performance",
        "monitoring"
    ],
    "homepage": "https://github.com/stayallive/lighthouse-graphql-hive",
    "license": "MIT",
    "authors": [
        {
            "name": "Alex Bouma",
            "email": "alex@bouma.me"
        }
    ],
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.8|^8",
        "laravel/framework": "^12|^13",
        "nuwave/lighthouse": "^6"
    },
    "autoload": {
        "psr-4": {
            "Stayallive\\Lighthouse\\GraphQLHive\\": "src/"
        }
    },
    "require-dev": {
        "chieftools/php-cs-fixer": "1.1.*",
        "orchestra/testbench": "^10|^11",
        "phpunit/phpunit": "^11.5|^12|^13"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Stayallive\\Lighthouse\\GraphQLHive\\ServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit --stop-on-failure",
        "test:ci": "vendor/bin/phpunit",
        "phpcs": "vendor/bin/php-cs-fixer fix",
        "phpcs:ci": "vendor/bin/php-cs-fixer fix --dry-run --diff"
    },
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "optimize-autoloader": true,
        "allow-plugins": {
            "chieftools/php-cs-fixer": true
        }
    }
}
